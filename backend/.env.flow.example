# Copy to backend/.env for the new API. Existing variables may stay there.
FLOW_LLM_PROVIDER=ollama
FLOW_LLM_BASE_URL=http://127.0.0.1:11434
FLOW_LLM_MODEL=qwen3:8b
FLOW_LLM_TIMEOUT=240
FLOW_LLM_CONTEXT=32768
FLOW_MAX_CONTEXT_CHARS=60000
FLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tsarev2709.github.io
# For LM Studio or another OpenAI-compatible endpoint:
# FLOW_LLM_PROVIDER=compatible
# FLOW_LLM_BASE_URL=http://127.0.0.1:1234/v1
# FLOW_LLM_MODEL=your-model
# FLOW_LLM_API_KEY=optional-key
